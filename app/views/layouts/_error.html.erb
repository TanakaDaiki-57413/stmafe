<% if obj.errors.any? %>
  <div id="error_messages" class="alert alert-danger border border-dark">
    <h5><%= obj.errors.count %>件のエラーが発生しました</h5>
    <ol class="mb-0">
      <% obj.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ol>
  </div>
<% end %>