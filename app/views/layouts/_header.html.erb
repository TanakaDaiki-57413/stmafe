<header>
  <div class="container-fluid header_cot py-1 mx-2 my-2">
    <div class="row">
      <div class="col-2">
        <%# タイトルロゴ部分 %>
        <%= link_to root_path, class: "text-decoration-none text-dark" do %>
          <table>
            <tr>
              <td rowspan="2">
                <i class="fa-solid fa-book-open fs-1 text-primary"></i>
              </td>

              <td>
                <span class="fs-3 fw-light ms-2">STMAFE</span>
              </td>
            </tr>
            <tr>
              <td>
                <span class="fs-6 text-secondary ms-2">ITレビュー教材サイト</span>
              </td>
            </tr>
          </table>
        <% end %>
      </div>

      <%# 検索入力欄 %>
      <div class="col-4 d-flex align-items-center">
        <select class="w-25 h-50">
          <option value="">選んでください</option>
          <option value="user">ユーザー</option>
          <option value="material">教材</option>
        </select>
        <input class="w-50 h-50" type="text" placeholder=" キーワードで検索">
        <button class="h-50" type="button">🔍</button>
      </div>
      
       <%# グローバルナビゲーション %>
      <div class="col-6  d-flex align-items-center justify-content-evenly">

        <%# ログインユーザーの場合 %>
        <% if authenticated_user? %>
          <%= link_to "教材を探す", materials_path, class: "text-decoration-none text-dark fs-5 fw-bold" %>
          <%= link_to "ユーザーを探す", users_path, class: "text-decoration-none text-dark fs-5 fw-bold" %>

          <%# 教材リクエスト用ドロップダウン %>
          <div class="dropdown"> 

            <button class="btn dropdown-toggle dropdown-mark-none no-border fs-5 fw-bold" type="button" data-bs-toggle="dropdown" aria-expanded="false"> 
              教材リクエスト
            </button> 

            <ul class="dropdown-menu"> 
              <li> <%= link_to "申請", new_request_path, class: "dropdown-item" %> </li> 
              <li> <%= link_to "履歴", requests_path, class: "dropdown-item" %> </li>
            </ul> 
          </div>

          <%# 通知用ドロップダウン %>
          <div class="dropdown">
            <button
              class="btn dropdown-toggle dropdown-mark-none no-border"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false">

              <i class="fa-regular fa-envelope fs-4"></i>

              <% if @notifications.present? %>
                <span class="badge bg-danger">
                  <%= @notifications.count %>
                </span>
              <% end %>
            </button>

            <ul class="dropdown-menu dropdown-menu-end">

              <% if @notifications.present? %>
                <% @notifications.each do |notification| %>
                  <li>
                    <%= link_to notification.message,
                                notification_path(notification),
                                class: "dropdown-item" %>
                  </li>
                <% end %>
              <% else %>
                <li>
                  <span class="dropdown-item-text">通知はありません</span>
                </li>
              <% end %>
            </ul>
          </div>

          <%# ユーザー用ドロップアウト %>
          <div class="dropdown"> 

            <button class="btn dropdown-toggle no-border fs-4" type="button" data-bs-toggle="dropdown" aria-expanded="false"> 
              <%= image_tag current_user.get_profile_image(25,25), class:"rounded-circle" %> 
              <%= truncate(current_user.nickname, length: 6, omission: ".") %> 
            </button> 

            <ul class="dropdown-menu"> 
              <li> <%= link_to "マイページ", user_path(current_user.public_uid), class: "dropdown-item" %> </li> 
              <li> <%= button_to "ログアウト",
                       destroy_user_session_path,
                       method: :delete,
                       class: "dropdown-item text-decoration-none text-dark" %></li>
            </ul> 
          </div>
        
        <%# ゲストユーザーの場合 %>
        <% else %>
          <%= link_to "教材を探す", materials_path, class: "text-decoration-none text-dark fs-5 fw-bold" %>
          <%= link_to "ユーザーを探す", users_path, class: "text-decoration-none text-dark fs-5 fw-bold" %>
          <%= link_to "新規登録", new_user_registration_path, class: "text-decoration-none text-dark fs-5 fw-bold" %>
          <%= link_to "ログイン", new_user_session_path, class: "text-decoration-none text-dark fs-5 fw-bold" %>
        <% end %>
      </div>
    </div>
  </div>

</header>