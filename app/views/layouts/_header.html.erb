<header>

  <%# ========================= %>
  <%# PC・タブレット用ヘッダー %>
  <%# ========================= %>
  <div class="d-none d-md-block">
    <div class="container-fluid px-3 py-2">

      <div class="d-flex align-items-center gap-3">

        <%# ロゴ %>
        <div class="flex-shrink-0">
          <%# 管理者がログインの場合 %>
          <% if current_admin %>
            <%= link_to admin_root_path, class: "text-decoration-none text-dark" do %>
              <div class="d-flex align-items-center">
  
                <i class="fa-solid fa-book-open fs-1 text-primary"></i>
  
                <div class="ms-2 text-nowrap">
                  <div class="fs-3 fw-light">
                    STMAFE
                  </div>
  
                  <div class="fs-6 text-secondary">
                    ITレビュー教材サイト
                  </div>
                </div>
              </div>
            <% end %>

          <%# 未ログイン・もしくはログイン済の場合 %>
          <% else %>
            <%= link_to root_path, class: "text-decoration-none text-dark" do %>
              <div class="d-flex align-items-center">

                <i class="fa-solid fa-book-open fs-1 text-primary"></i>

                <div class="ms-2 text-nowrap">
                  <div class="fs-3 fw-light">
                    STMAFE
                  </div>

                  <div class="fs-6 text-secondary">
                    ITレビュー教材サイト
                  </div>
                </div>

              </div>
            <% end %>
          <% end %>
        </div>

        <%# 検索 %>
        <div class="d-flex flex-grow-1" style="max-width: 450px;">

          <select class="form-select w-auto flex-shrink-0">
            <option value="">選択</option>
            <option value="user">ユーザー</option>
            <option value="material">教材</option>
          </select>

          <input
            class="form-control"
            type="text"
            placeholder="キーワードで検索">

          <button
            class="btn btn-primary flex-shrink-0"
            type="button">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>

        </div>

        <%# グローバルナビゲーション %>
        <div class="d-flex align-items-center gap-3 ms-auto flex-nowrap">

          <%# ログイン済ヘッダー %>
          <% if current_user %>

            <%= link_to "教材を探す",
                materials_path,
                class: "text-decoration-none text-dark fs-6 fw-bold text-nowrap" %>

            <%= link_to "ユーザーを探す",
                users_path,
                class: "text-decoration-none text-dark fs-6 fw-bold text-nowrap" %>

            <%# 教材リクエスト %>
            <div class="dropdown">
              <button
                class="btn dropdown-toggle dropdown-mark-none no-border fs-6 fw-bold text-nowrap"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">
                教材リクエスト
              </button>

              <ul class="dropdown-menu">
                <li>
                  <%= link_to "申請",
                      new_request_path,
                      class: "dropdown-item" %>
                </li>

                <li>
                  <%= link_to "履歴",
                      requests_path,
                      class: "dropdown-item" %>
                </li>
              </ul>
            </div>

            <%# 通知 %>
            <div class="dropdown">
              <button
                class="btn dropdown-toggle dropdown-mark-none no-border"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">

                <i class="fa-regular fa-envelope fs-4"></i>

                <% if @notifications.present? %>
                  <span class="badge bg-danger">
                    <%= @notifications.count %>
                  </span>
                <% end %>

              </button>

              <ul class="dropdown-menu dropdown-menu-end">

                <% if @notifications.present? %>

                  <% @notifications.each do |notification| %>
                    <li>
                      <%= link_to notification.message,
                          notification_path(notification),
                          class: "dropdown-item" %>
                    </li>
                  <% end %>

                <% else %>

                  <li>
                    <span class="dropdown-item-text">
                      通知はありません
                    </span>
                  </li>

                <% end %>

              </ul>
            </div>

            <%# ユーザー %>
            <div class="dropdown flex-shrink-0">

              <button
                class="btn dropdown-toggle no-border fs-6 text-nowrap"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">

                <%= image_tag current_user.get_profile_image(25,25),
                    class: "rounded-circle" %>

                <%= truncate(
                      current_user.nickname,
                      length: 6,
                      omission: "."
                    ) %>

              </button>

              <ul class="dropdown-menu dropdown-menu-end">

                <li>
                  <%= link_to "マイページ",
                      user_path(current_user.public_uid),
                      class: "dropdown-item" %>
                </li>

                <li>
                  <%= button_to "ログアウト",
                      destroy_user_session_path,
                      method: :delete,
                      class: "dropdown-item text-dark" %>
                </li>

              </ul>

            </div>

          <%# 管理者用ヘッダー %>
          <% elsif current_admin %>
            
            <%# 管理機能ドロップダウン %>
            <div class="dropdown flex-shrink-0">

                <button
                  class="btn dropdown-toggle no-border fs-6 text-nowrap"
                  type="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false">
                  
                  <p>管理機能</p>

                </button>

                <ul class="dropdown-menu dropdown-menu-end">

                  <li>
                    教材管理
                  </li>

                  <li>
                    レビュー管理
                  </li>

                  <li>
                    ユーザー管理
                  </li>

                  <li>
                    リクエスト管理
                  </li>

                </ul>

            </div>

            <%# 登録機能ドロップダウン %>
            <div class="dropdown flex-shrink-0">

                <button
                  class="btn dropdown-toggle no-border fs-6 text-nowrap"
                  type="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false">
                  
                  <p>登録機能</p>

                </button>

                <ul class="dropdown-menu dropdown-menu-end">

                  <li>
                    教材登録
                  </li>

                  <li>
                    カテゴリ登録
                  </li>

                  <li>
                    タグ登録
                  </li>

                </ul>

            </div>

            <%= button_to "ログアウト",
                  destroy_admin_session_path,
                  method: :delete,
                  class: "dropdown-item text-dark" %>

          <%# 未ログイン ヘッダー %>
          <% else %>

            <%= link_to "教材を探す",
                materials_path,
                class: "text-decoration-none text-dark fs-6 fw-bold text-nowrap" %>

            <%= link_to "ユーザーを探す",
                users_path,
                class: "text-decoration-none text-dark fs-6 fw-bold text-nowrap" %>

            <%= link_to "新規登録",
                new_user_registration_path,
                class: "text-decoration-none text-dark fs-6 fw-bold text-nowrap" %>

            <%= link_to "ログイン",
                new_user_session_path,
                class: "text-decoration-none text-dark fs-6 fw-bold text-nowrap" %>

          <% end %>

        </div>
      </div>
    </div>
  </div>


  <%# ========================= %>
  <%# スマホ用ヘッダー %>
  <%# ========================= %>
  <div class="d-md-none">

    <div class="container-fluid px-3 py-2">

      <%# 上段 %>
      <div class="d-flex align-items-center">

        <%# ロゴ %>
        <div class="flex-grow-1">
          <%= link_to root_path, class: "text-decoration-none text-dark" do %>

            <div class="d-flex align-items-center">

              <i class="fa-solid fa-book-open fs-2 text-primary"></i>

              <div class="ms-2 text-nowrap">
                <div class="fs-4 fw-light">
                  STMAFE
                </div>

                <div class="fs-6 text-secondary">
                  ITレビュー教材サイト
                </div>
              </div>

            </div>

          <% end %>
        </div>
        <% if current_user %>

          <%# 通知 %>
          <div class="dropdown me-2">

            <button
              class="btn dropdown-toggle dropdown-mark-none no-border p-1"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false">

              <i class="fa-regular fa-envelope fs-5"></i>

              <% if @notifications.present? %>
                <span class="badge bg-danger">
                  <%= @notifications.count %>
                </span>
              <% end %>

            </button>

            <ul class="dropdown-menu dropdown-menu-end">

              <% if @notifications.present? %>

                <% @notifications.each do |notification| %>
                  <li>
                    <%= link_to notification.message,
                        notification_path(notification),
                        class: "dropdown-item" %>
                  </li>
                <% end %>

              <% else %>

                <li>
                  <span class="dropdown-item-text">
                    通知はありません
                  </span>
                </li>

              <% end %>

            </ul>
          </div>


          <%# ユーザー %>
          <div class="dropdown me-2">

            <button
              class="btn dropdown-toggle no-border p-1"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false">

              <%= image_tag current_user.get_profile_image(30,30),
                  class: "rounded-circle" %>

            </button>

            <ul class="dropdown-menu dropdown-menu-end">

              <li>
                <%= link_to "マイページ",
                    user_path(current_user.public_uid),
                    class: "dropdown-item" %>
              </li>

              <li>
                <%= button_to "ログアウト",
                    destroy_user_session_path,
                    method: :delete,
                    class: "dropdown-item text-dark" %>
              </li>

            </ul>

          </div>

        <% end %>


        <%# ハンバーガーボタン %>
        <button
          class="btn p-1"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mobileMenu"
          aria-expanded="false"
          aria-controls="mobileMenu">

          <i class="fa-solid fa-bars fs-3"></i>

        </button>

      </div>


      <%# ハンバーガーメニュー %>
      <div class="collapse mt-3" id="mobileMenu">

        <div class="d-flex flex-column gap-3 border-top pt-3">

          <%= link_to "教材を探す",
              materials_path,
              class: "text-decoration-none text-dark fs-6 fw-bold" %>

          <%= link_to "ユーザーを探す",
              users_path,
              class: "text-decoration-none text-dark fs-6 fw-bold" %>

          <% if current_user %>

            <div class="dropdown">

              <button
                class="btn dropdown-toggle dropdown-mark-none no-border p-0 fs-6 fw-bold"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">

                教材リクエスト

              </button>

              <ul class="dropdown-menu">

                <li>
                  <%= link_to "申請",
                      new_request_path,
                      class: "dropdown-item" %>
                </li>

                <li>
                  <%= link_to "履歴",
                      requests_path,
                      class: "dropdown-item" %>
                </li>

              </ul>

            </div>

          <% else %>

            <%= link_to "新規登録",
                new_user_registration_path,
                class: "text-decoration-none text-dark fs-6 fw-bold" %>

            <%= link_to "ログイン",
                new_user_session_path,
                class: "text-decoration-none text-dark fs-6 fw-bold" %>

          <% end %>

        </div>

      </div>

    </div>
  </div>

</header>