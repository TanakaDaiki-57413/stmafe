<div class="container mt-3">
  <%= render "layouts/error", obj:@review %>
  <div class="row g-3">
    <div class="col-md-4 col-sm-12">
      <div class="card">
        <%= image_tag @material.get_cover_image(100,100) %>

        <div class="card-title px-1">
          <h3><%= @material.title %></h3>
        </div>

        <div class="card-subtitle small mb-2 px-1">
          <span>著者：</span>
          <%= @material.author %><br>
          <span>出版社：</span>
          <%= @material.publisher%>
        </div>

        <div class="card-body">
          <span class="small"><%= @material.body %></span>
        </div>

        <div class="card-text px-1 py-2">
          <span>カテゴリ：</span>
          <%= @material.category.name%><br>

          <span>レベル：</span>
          <%= @material.study_level %><br>

          <span>価格(税込)：</span>
          <%= @material.price %>円<br>

          <span>発売日：</span>
          <%= @material.release_date%><br>


          <span>ISBN番号：</span>
          <%= @material.isbn_number%><br>
        </div>

        <div class="card-footer">
          <div class="d-flex align-items-center mt-3 mb-2 text-nowrap "> 
            <span>平均評価：</span>
            <div class="lg-star mb-1" 
                id="show_raty"
                data-score="<%= @material.average_rating %>"
                data-star-on="<%= asset_path('star-on.png') %>"
                data-star-off="<%= asset_path('star-off.png') %>"
                data-star-half="<%= asset_path('star-half.png') %>">
            </div>
            <div class="ms-2">
              (<%= @material.average_rating %>)
            </div>
          </div>
          <div class="d-flex flex-wrap">
            <% @material.material_tags.each do | tags | %>
              <div class="bg-primary text-light small me-1 rounded-4 px-2 mb-1 mt-1">
                <%= tags.tag.name %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-5 col-sm-12 mx-auto">
      <h1>レビュー編集</h1>
      <%= form_with model:@review, 
          url:material_review_path(@material,@review ,return_to: @return_to),
          method: :patch ,
          data: {turbo: false} do |form| %>
  
        <div class="fw-bold me-2">
              評価:
        </div>
        <div id="edit_raty"
            class="raty"
            data-score="<%= @review.rate %>"
            data-star-on="<%= asset_path('star-on.png') %>"
            data-star-off="<%= asset_path('star-off.png') %>"
            data-star-half="<%= asset_path('star-half.png') %>">
        </div>

        <div class="mt-3">
          <%= form.label :study_time, "学習時間 ※時間単位で入力", class:"fw-bold" %><br>
          <%= form.text_field :study_time ,class:"form-control mt-2", placeholder:"例: 100"%>
        </div>

        <div class="mt-3">
          <%= form.label :content, "レビュー内容" , class:"fw-bold" %><br>
          <%= form.text_area :content ,
                             class: "form-control mt-2",
                             style: "height: 250px;" %>
        </div>

        <div class="mt-4 text-end">
          <%= form.submit "編集内容を保存", class:"w-50, btn btn-success"%>
          <%= link_to "戻る", @return_to || material_path(@review.material), class:"w-50, btn btn-danger"%>
        </div>
      
      <% end %>
    </div>
  </div>
</div>