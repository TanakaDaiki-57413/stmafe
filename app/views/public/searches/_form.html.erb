
<%= form_with url: search_path, method: :get, local: true do |f| %>
  <div class="d-flex flex-grow-1" style="max-width: 450px;">
    <%= f.select :model, options_for_select({ "ユーザー" => "user", "教材" => "material" }),class:"form-select w-auto flex-shrink-0" %>


    <%= f.text_field :keyword,
                class:"form-control",
                placeholder:"キーワードで検索" %>

    <%= f.submit '🔍', class:"btn btn-primary flex-shrink-0" %>
  </div>
<% end %>
