<div class="container w-50 mx-auto">
  <div class="row mt-4 mb-4">
    <div class="row align-items-center">

      <div class="col-md-8 border-bottom">
        <h5 class="px-3 py-2 fs-3">申請内容確認</h5>
      </div>

    </div>
  </div>

  <%= form_with model: @request,
                url: requests_path,
                method: :post do |form| %>
                
    <p>下記内容で間違いありませんか？</p>
    <%# リクエスト教材名確認フォーム %>
    <div class="row mb-4 mt-3">
      <div class="col-8">
        <%= form.label :title, "リクエスト教材名", class: "form-label mb-1" %>

        <%= form.text_field :title,
                            required: true,
                            readonly: true,
                            class: "form-control",
                            placeholder: "教材名" %>
      </div>
    </div>

    <%# 著者確認フォーム %>
    <div class="row mb-4">
      <div class="col-8">
        <%= form.label :author, "著者", class: "form-label mb-1" %>
        <%= form.text_field :author,
                            class: "form-control",
                            readonly: true,
                            placeholder: "著者名" %>
      </div>
    </div>
    
    <%# 出版社確認フォーム %>
    <div class="row mb-3">
      <div class="col-md-8">
        <%= form.label :publisher, "出版社", class: "form-label mb-1" %>
        <%= form.text_field :publisher,
                            required: true,
                            readonly: true,
                            class: "form-control",
                            placeholder: "出版社" %>
      </div>
    </div>

    <%# ISBN番号確認フォーム %>
    <div class="row mb-3">
      <div class="col-md-8">
        <%= form.label :isbn_number, "ISBN番号", class: "form-label mb-1" %>

        <%= form.text_field :isbn_number,
                            required: true,
                            readonly: true,
                            class: "form-control",
                            placeholder: "ISBN番号" %>
      </div>
    </div>


    <%# 申請/キャンセル ボタン %>
    <div class="row mt-4 mb-4">
      <div class="col-md-8 text-end">
        <%= form.submit "申請",
                        class: "btn btn-success px-5" %>
        <%= link_to "キャンセル", new_request_path,
                        class: "btn btn-danger px-5" %>
      </div>
    </div>
  <% end %>
</div>