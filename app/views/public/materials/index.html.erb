<div class="w-50 mt-3" style="margin-left:8em"><%= render "layouts/flash" %></div>
<div class="container">
  <div class="row">
    <div class="row mb-3 mt-3">
      <div class="col-5">
        <% if  @q.conditions.blank? && @tag_ids.blank? %>
          <h2>教材一覧</h2>
        <% else %>
          <h2>教材検索結果</h2>
        <%end%>
      </div>
    </div>
    
  </div>
  <div class="row">
    <%= render "public/shared/filter_form",q: @q %>

    <div class="col-md-9">
      <%= render "public/shared/index_materials", materials: @materials%>
    </div>
  </div>
</div>