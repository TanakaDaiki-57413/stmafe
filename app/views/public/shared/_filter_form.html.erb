<div class="col-md-3 border border-dark md-position-sticky">
  <%= search_form_for q, url: materials_path do |f| %>
    <div class="d-flex align-items-center">
      <div class="w-50">
        <h5>絞込検索</h5>
      </div>
      <div class="w-50 text-end">
        <%= link_to "検索条件をリセット", materials_path%>
      </div>
    </div>

    <div class="mt-3 mb-2">
      <%= f.label :sorts, "並び替え", class: "form-label small fw-bold" %>
      <%= f.select :sorts, {
        "指定なし": "",
        "評価の高い順": "average_rating desc",
        "レビュー件数の多い順": "reviews_count desc",
        "発売日が新しい順": "release_date desc",
        "新着レビュー順": "reviews_created_at desc"

      }, { selected: params.dig(:q, :sorts) }%>
    </div>
    <div>
      <%= f.label :title_cont, "教材名", class: "form-label small fw-bold" %>
      <%= f.text_field :title_cont, class:"w-100" %>
    </div>

    <div>
      <%= f.label :category_id_eq, "カテゴリ", class: "form-label small fw-bold" %><br>
      <%= f.collection_select(
            :category_id_eq,
            Category.all,
            :id,
            :name,
            { include_blank: "---" }
          ) %>
    </div>
      
    <div>
      <%= f.label :study_level_eq, "勉強レベル", class: "form-label small fw-bold" %><br>
      <%= f.select(
            :study_level_eq,
            Material.distinct.pluck(:study_level),
            { include_blank: "---" }
          ) %>
    </div>
      
    <div class="mt-2">
      <span class= "form-label small fw-bold">タグ</span>
      <%# スクロールバー設定 %>
      <div class="overflow-scroll 
                  overflow-hidden 
                  overflow-x-auto
                  border
                  border-dark
                  px-1" 
           style="height:220px;">
        <%# タグチェックボックス %>
        <% Tag.all.each do |tag| %>
          <label>
            <%= check_box_tag(
                  "tag_ids[]",
                  tag.id,
                  params[:tag_ids]&.include?(tag.id.to_s),
                ) %>
    
            <%= tag.name %>
          </label>
        <% end %>
      </div>
    </div>
      
    <div class="text-end mt-2">
      <%= f.submit "検索" %>
    </div>     
  <% end %>
</div>