<div class="container w-75 mx-auto py-4">
  <h1 class="mb-4">ユーザー</h1>

  <div class="row g-4">
    <% @users.each do |user| %>
      <div class="col-12 col-md-6 col-lg-4">
        <%= link_to user_path(user.public_uid), 
            class: "text-decoration-none" do %>

          <div class="card h-100">
            <div class="card-body text-center">

              <%= image_tag user.get_profile_image(80, 80),
                  class: "rounded-circle mb-2" %>

              <h5 class="card-title">
                <%= user.nickname %>
              </h5>

              <h5 class="card-subtitle small text-primary">
                <span>
                  レビュー数<%= user.reviews.count%>
                  フォロー数<%= user.followings.count %> 
                  フォロワー数<%= user.followers.count%>
                <span>
              </h5>

              <p class="card-text text-muted small text-break  mt-2">
                <%= truncate(user.introduction,length: 58) %>
              </p>
            </div>
          </div>

        <% end %>
      </div>
    <% end %>
  </div>
</div>