<div class="w-50 mt-3" style="margin-left:8em"><%= render "layouts/flash" %></div>
<div class="container">
  <div class="row">
    <%# レビュー一覧 %>
    <div class="col-md-9 no-border">
      <div class="d-flex align-items-center">
        <div class="w-50">
          <h2> <%= link_to @user.nickname, user_path(@user.public_uid),class:"text-decoration-none" %>さんのレビュー一覧</h2>
        </div>
        <div class="w-50 text-end">
          <%= search_form_for @q, url: user_reviewing_path(@user.public_uid) do |f| %> 
            <%= f.label :sorts, "並び替え", class: "form-label small fw-bold" %>
            <%= f.select :sorts, {
              "投稿が新しい順": "created_at desc",
              "投稿が古い順": "created_at asc",
              "評価の高い順": "rate desc",
              "勉強時間が多い順": "study_time desc"
            }, { selected: params.dig(:q, :sorts) },{ onchange: 'this.form.submit()' }%>
          <% end %>
        </div>
      </div>
      <% @reviews.each do |reviewer| %>
        <div class="row py-3 border-top">

          <%# レビュー教材画像 %>
          <div class="col-3 d-flex justify-content-center align-items-center">
            <%= link_to material_path(reviewer.material),class:"text-decoration-none" do %>
              <%= image_tag reviewer.material.get_cover_image(200,200),class:"img-fluid"%>
            <% end %>
          </div>

          <%# レビュー内容 %>
          <div class="col-9 d-flex flex-wrap">
            <div class="w-100">
              
              <%= link_to reviewer.material.title, material_path(reviewer.material) ,class:"fs-4 text-decoration-none" %>
            </div>

            <div class="d-flex align-items-center w-100">
              <div class="d-flex w-50">
                <div id="all_show_raty" 
                      class="xs-star ms-2 raty"
                      data-score="<%= reviewer.rate %>"
                      data-star-on="<%= asset_path('star-on.png') %>"
                      data-star-off="<%= asset_path('star-off.png') %>"
                      data-star-half="<%= asset_path('star-half.png') %>">               
                </div>
                <div class="ms-2">
                  (<%= reviewer.rate %>)
                </div> 
              </div>

              <div class="w-50 d-flex justify-content-end text-secondary ">
                <span>学習時間：<%= reviewer.study_time %>時間</span> 
                <span class="ms-4"><%= reviewer.created_at.strftime("%Y年%m月%d日")%></span>
              </div>
            </div>

            <div class="w-100 px-2 mt-3 mb-5 text-break">
              <span><%= reviewer.content %></span>
            </div>

            <%# 投稿本人の時に表示 %>
            <% if reviewer.user == current_user %>
              <div class="w-100 text-end">
                <%= link_to "編集",  edit_material_review_path(reviewer.material,reviewer,return_to: request.fullpath) ,class:"btn btn-success"%>
                <%= link_to "削除", material_review_path(reviewer.material,reviewer) ,
                                  class:"btn btn-danger",
                                  data: { 
                                    turbo_method: :delete,
                                    turbo_confirm: "本当に削除しますか？"
                                  }%>
              </div>
            <% end %>
          </div>
          
        </div>      
      <% end %>
    </div>
  </div>
</div>