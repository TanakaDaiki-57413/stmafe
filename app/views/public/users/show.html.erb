<div class="container w-75 mx-auto mt-5">
  <div class="w-50"><%= render "layouts/flash" %></div>
  <%# ユーザープロフィール %>
  <div class="card px-3 py-3">
    <div class="row">

      <%# プロフィール画像 %>
      <div class="col-12 col-md-3 text-center mb-3 mb-md-0">
          <%= image_tag @user.get_profile_image(150,150),class:"rounded-circle"%>
      </div>

      <div class="col-12 col-md-9">

        <%# ユーザー名/プロフィール設定ボタン %>
        <div class="row">

          <div class="col-12 col-md">
            <h1><%= @user.nickname %></h1>
          </div>

          <% if @user == current_user %>
            <div class="col-12 col-md-auto mt-2 mt-md-0">
              <div class="text-end">
                <%=  link_to "プロフィール設定", users_profile_edit_path, class:"btn btn-success px-3 py-2" %> 
              </div>
            </div>
          <% end %>

        </div>

        <%# 自己紹介文 %>
        <div class="row">
          <div class="col-12 col-lg-8">
            <% if @user.introduction.blank? %>
              <p class="text-secondary mt-2">自己紹介文は設定されていません</p>
            <% elsif @user.introduction %>
              <p class="text-secondary mt-2"><%= @user.introduction %></p>
            <% else %>
              <p class="text-secondary mt-2">自己紹介文は設定されていません</p>
            <% end %>
          </div>
        </div>
        
        <%# レビュー数/お気に入り数/フォロー数/フォロワー数 %>
        <div class="row mt-3">
          <div class="col-6 col-lg-3 mb-3 mb-lg-0">
            <i class="fa-regular fa-square-check text-primary"></i>
            レビュー数:
            <%= @user.reviews.count %>
          </div>

          <div class="col-6 col-lg-3 mb-3 mb-lg-0">
            <i class="fa-solid fa-bookmark text-primary"></i>
            お気に入り数: 
            <%= @user.bookmarks.count %>
          </div>

          <div class="col-6 col-lg-3 mb-3 mb-lg-0">
           <i class="fa-solid fa-users text-primary"></i>
            フォロー:
            <%= @user.followings.count %>
          </div>

          <div class="col-6 col-lg-3 mb-3 mb-lg-0">
            <i class="fa-solid fa-users text-primary"></i>
            フォロワー:
             <%= @user.followers.count %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%# 最近のレビュー %>
  <div class="row mt-5">
    <div class="col-4">
      <h5>最近のレビュー</h5>
    </div>

    <div class="col-4 text-end text-primary">
      <% unless @user.reviews.count == 0 %>
        <%= link_to "すべて見る", user_reviewing_path(@user.public_uid) %>
      <% end %>
    </div>
  </div>
  <%# ユーザーの新着レビューを3件表示 %>
  <div class="row">
    <div class="col-md-8 border rounded-3">
      <% @reviews.each do |review| %>
        <div class="row">
          <div class="col-4 border-bottom">
            <%= link_to material_path(review.material) do %>
              <%= image_tag review.material.get_cover_image(150,150),
                  class:"img-fluid" %>
            <% end %>
          </div>
          <div class="col-8 py-3 d-inline-block border-bottom">
            <div class="w-100">
              <%= link_to review.material.title, material_path(review.material) ,class:"fs-4 text-decoration-none" %>
            </div>
            <div>
              <span class="text-warning me-5">★★★★★ <%= review.rate %></span>
              <span>学習時間：<%= review.study_time %>時間</span>
            </div>
            <div class="mt-2 mx-1">
              <p><%= truncate(review.content ,length:50 ) %></p>
            </div>
            <div class="text-end text-secondary">
              <%= review.created_at.strftime("%Y年%m月%d日")%>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  
</div>