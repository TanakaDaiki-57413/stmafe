<div class="container w-75 mx-auto mt-5">
  <div class="w-50"><%= render "layouts/flash" %></div>
  <%# ユーザープロフィール %>
  <div class="card px-3 py-3">
    <div class="row">

      <%# プロフィール画像 %>
      <div class="col-12 col-md-3 text-center mb-3 mb-md-0">
          <%= image_tag @user.get_profile_image(150,150),class:"rounded-circle"%>
      </div>

      <div class="col-12 col-md-9">

        <%# ユーザー名/プロフィール設定ボタン %>
        <div class="row">

          <div class="col-12 col-md">
            <h1><%= @user.nickname %></h1>
          </div>

          <% if @user == current_user %>
            <div class="col-12 col-md-auto mt-2 mt-md-0">
              <div class="text-end">
                <%=  link_to "プロフィール設定", users_profile_edit_path, class:"btn btn-success px-3 py-2" %> 
              </div>
            </div>
          <% end %>

        </div>

        <%# 自己紹介文 %>
        <div class="row">
          <div class="col-12 col-lg-8">
            <% if @user.introduction.blank? %>
              <p class="text-secondary mt-2">自己紹介文は設定されていません</p>
            <% elsif @user.introduction %>
              <p class="text-secondary mt-2"><%= @user.introduction %></p>
            <% else %>
              <p class="text-secondary mt-2">自己紹介文は設定されていません</p>
            <% end %>
          </div>
        </div>
        
        <%# レビュー数/お気に入り数/フォロー数/フォロワー数 %>
        <div class="row mt-3">
          <div class="col-6 col-lg-3 mb-3 mb-lg-0">
            <i class="fa-regular fa-square-check text-primary"></i>
            レビュー数:
            <%= @user.reviews.count %>
          </div>

          <div class="col-6 col-lg-3 mb-3 mb-lg-0">
            <i class="fa-solid fa-bookmark text-primary"></i>
            お気に入り数: 
            <%= @user.bookmarks.count %>
          </div>

          <div class="col-6 col-lg-3 mb-3 mb-lg-0">
           <i class="fa-solid fa-users text-primary"></i>
            フォロー:
            <%= @user.followings.count %>
          </div>

          <div class="col-6 col-lg-3 mb-3 mb-lg-0">
            <i class="fa-solid fa-users text-primary"></i>
            フォロワー:
             <%= @user.followers.count %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%# 最近のレビュー %>
  <div class="row mt-5">
    <div class="col-4">
      <h5>最近のレビュー</h5>
    </div>

    <div class="col-4 text-end text-primary">
      <% unless @user.reviews.count == 0 %>
        <%= link_to "すべて見る", user_reviewing_path(@user.public_uid), class: "text-decoration-none" %>
      <% end %>
    </div>
  </div>
  <%# ユーザーの新着レビューを3件表示 %>
  <div class="row">
    <div class="col-md-8 border rounded-3">
      <% @reviews.each do |review| %>
        <div class="row">
          <div class="col-4 border-bottom">
            <%= link_to material_path(review.material) do %>
              <%= image_tag review.material.get_cover_image(150,150),
                  class:"img-fluid" %>
            <% end %>
          </div>
          <div class="col-8 py-3 d-inline-block border-bottom">
            <div class="w-100">
              <%= link_to review.material.title, material_path(review.material) ,class:"fs-4 text-decoration-none" %>
            </div>
            <div>
              <div class="d-flex align-items-center">
                <div id="all_show_raty" 
                    class="xs-star ms-2 raty"
                    data-score="<%= review.rate %>"
                    data-star-on="<%= asset_path('star-on.png') %>"
                    data-star-off="<%= asset_path('star-off.png') %>"
                    data-star-half="<%= asset_path('star-half.png') %>">               
                </div>
                <div class="ms-2">
                  (<%= review.rate %>)
                </div>     
                <div class="w-50 text-end">
                  <span>学習時間：<%= review.study_time %>時間</span>
                </div>
              </div>
            </div>
            <div class="mt-2 mx-1">
              <p><%= truncate(review.content ,length:50 ) %></p>
            </div>
            <div class="text-end text-secondary">
              <%= review.created_at.strftime("%Y年%m月%d日")%>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>


  <div class="row mt-5">
    <div class="col-4">
      <h5>お気に入り教材</h5>
    </div>
    <div class="col-4 text-end text-primary">
      <% unless @user.bookmarks.count == 0 %>
        <%= link_to "すべて見る", user_bookmarking_path(@user.public_uid), class: "text-decoration-none" %>
      <% end %>
    </div>
  </div>
  
  <%# お気に入り教材を3件表示 %>
  <div class="row">
    <div class="col-md-8">
      <div class="row">
        <% @bookmarks.each do |bookmark| %>
          <div class="col-md-4">
            <div class="card h-100 px-1">
              <%= link_to material_path(bookmark.material),class:"text-decoration-none" do%>
                <%= image_tag bookmark.material.get_cover_image(100,100),
                              class:"card-img-top" %>

                <div class="card-title small fw-bold">
                  <%= bookmark.material.title %>
                </div>
              <%end%>

              <div class="card-subtitle small text-secondary">
                著者：<%= bookmark.material.author %><br>
                出版社：<%= bookmark.material.publisher %><br>
                価格：<%= bookmark.material.price %>円<br>
                カテゴリ：<%= bookmark.material.category.name %><br>
                レベル：<%= bookmark.material.study_level %>
              </div>

              <div class="card-body small px-1 my-auto">
                <%= truncate(bookmark.material.body, length:50)%>
              </div>

              <div class="card-text small">
                <div class="d-flex flex-wrap align-items-baseline">
                  <% bookmark.material.material_tags.each do | material | %>
                    <%= link_to materials_path(tag_ids:[material.tag.id]) do %>
                      <div class="bg-light text-primary badge rounded-4  px-2 me-1 mb-2">
                        <%= material.tag.name %>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>

              <div class="card-footer small text-warning d-flex align-items-center">
                <div class="fw-bold me-2"><%= bookmark.material.average_rating %></div>
                <div id="all_show_raty" 
                    class="xs-star raty"
                    style="margin-bottom:1.75px;"
                    data-score="<%= bookmark.material.average_rating %>"
                    data-star-on="<%= asset_path('star-on.png') %>"
                    data-star-off="<%= asset_path('star-off.png') %>"
                    data-star-half="<%= asset_path('star-half.png') %>">
                </div>
                <span class="text-primary badge">(<%= bookmark.material.reviews.count %>件)</span>
              </div>
            </div>
          </div>
        <%end%>
      </div>
    </div>
  </div>
</div>