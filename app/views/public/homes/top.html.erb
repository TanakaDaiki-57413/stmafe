<div class="w-50 mt-3" style="margin-left:8em"><%= render "layouts/flash" %></div>
<div class="container-fluid">
  <div class="row align-items-center py-5">
    <div class="col-6 sm-3 md-4 lg-1 ms-0">
      <h1 class="fw-bold text-center">
        あなたにぴったりの<br>
        IT教材が見つかる
      </h1>

      <p class="text-secondary text-center fs-5">
        ITエンジニア向き学習者のためのレビューサイト<br>
        現役エンジニアや学習者のリアルな声を参考に<br>
        最適な教材を見つけましょう
      </p>
    </div>
    <div class="col-6 text-center">
      <%= image_tag "12260_color.svg",
                    class: "img-fluid", 
                    alt: "img" %>
    </div>
  </div>
</div>

<!-- 検索エリア -->
<section>
  <div class="container">

    <div class="bg-white rounded shadow-sm p-4">
    
      <%= search_form_for @q, url: materials_path, class:"d-flex g-2 w-100" do |f| %>
        <div class="row g-3">

          <%# <!-- キーワード --> %>
          <div class="col-lg-4">
            <%= f.label :title_or_author_or_publisher_cont, "キーワード",
                    class: "form-label small fw-bold" %>

            <%= f.text_field :title_or_author_or_publisher_cont,
                  class:"form-control",
                  placeholder: "教材名/著者名/出版社" %>
          </div>

          <!-- カテゴリ -->
          <div class="col-lg-2">
    
            <%= label_tag :category_id,
                          "カテゴリ",
                          class: "form-label small fw-bold" %>
    
            <%= f.collection_select(
              :category_id_eq,
              Category.all,
              :id,
              :name,
              { include_blank: "---" },
              { class: "form-select"}
            ) %>
    
          </div>

          <!-- タグ -->
          <div class="col-lg-2">
            <%= label_tag :tag_id,
                          "タグ",
                          class: "form-label small fw-bold" %>

            <%# タグチェックボックス %>
            <%= select_tag(
              "tag_id",
              options_from_collection_for_select(
                Tag.all, #配列
                :id,     #value
                :name,   #表示
                params[:tag_id] #選択要素
              ),
              include_blank: "---",
              class: "form-select"
            ) %>

          </div>

          <!-- レベル -->
          <div class="col-lg-2">

            <%= f.label :study_level_eq, "勉強レベル", class: "form-label small fw-bold"  %>
            <%= f.select(
              :study_level_eq,
              Material.distinct.pluck(:study_level),
              { include_blank: "---" },
              { class:"form-select"}
            ) %>

          </div>

          <div class="col-lg-2 d-flex align-items-end">
            <%= f.submit "検索する" ,class:"btn btn-primary"%>
          </div>
        </div>
      <% end %> 
    </div>
  </div>
</section>
<section class="py-5">

  <div class="container">

    <div class="row g-4">

      <%# 新着レビュー %>
      <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-3">

          <h2 class="h5 fw-bold mb-0">
            <i class="fa-regular fa-square-check me-2"></i>
            新着レビュー
          </h2>

          <%= link_to "もっと見る",
                      materials_path,
                      class: "small text-decoration-none" %>

        </div>


        <%# レビュー一覧  %>
        <div class="row g-3">

          <% @reviews.each do |review| %>

            <div class="col-md-6 col-xl-3">

              <div class="card h-100 shadow-sm border-0">
                <%= link_to material_path(review.material) do %>
                  <%= image_tag review.material.cover_image,
                                class: "card-img-top p-3",
                                alt: "教材画像" %>
                <% end %>


                <div class="card-body">

                  <h3 class="h6 fw-bold">
                    <%= link_to review.material.title, material_path(review.material) ,class:"text-decoration-none "%>
                  </h3>

                  <p class="small text-secondary mb-2">
                    <%= review.material.author%>
                  </p>


                  <%# 評価 %>
                  <div class="small mb-2 d-flex align-items-center">

                    <div id="all_show_raty" 
                      class="xs-star raty mb-1 me-1"
                      data-score="<%= review.rate %>"
                      data-star-on="<%= asset_path('star-on.png') %>"
                      data-star-off="<%= asset_path('star-off.png') %>"
                      data-star-half="<%= asset_path('star-half.png') %>">
                    </div>

                    <span class="text-secondary">
                      (<%= review.rate %>)
                    </span>

                  </div>

                  <span class="badge text-bg-light text-primary">
                    <%= review.material.category.name%>
                  </span>


                  <p class="small text-secondary mt-3 mb-0">
                    <%= review.content %>
                  </p>

                </div>


                <%# 投稿者  %>
                <div class="card-footer bg-white border-0">

                  <small class="text-secondary">
                    学習時間:<%= review.study_time%>時間<br>
                    <i class="fa-solid fa-user me-1"></i>
                    <%= review.user.nickname%>
                    
                  </small>

                </div>

              </div>

            </div>

          <% end %>

        </div>

      </div>


      <%# 人気教材 %>
      <div class="col-lg-4">

        <div class="bg-white rounded shadow-sm p-3">

          <div class="d-flex justify-content-between align-items-center mb-3">

            <h2 class="h6 fw-bold mb-0">
              <i class="fa-solid fa-ranking-star me-2"></i>
              人気教材
            </h2>

          </div>
            
          <% @popular_materials.each_with_index do | material, i | %>

            <div class="d-flex align-items-center py-2 border-bottom">

              <!-- 順位 -->

              <div class="fw-bold text-secondary me-3">
                <%= i + 1%>
              </div>


              <!-- 教材名 -->

              <div class="flex-grow-1">

                <div class="small fw-bold">
                  <%= link_to material_path(material),class: "text-decoration-none" do%>
                    <%= material.title %>
                  <% end %>
                </div>

              </div>


              <!-- 評価 -->

              <div class="small d-flex align-items-center">

                <div id="all_show_raty" 
                  class="xs-star raty mb-1 me-1"
                  data-score="<%= material.average_rating %>"
                  data-star-on="<%= asset_path('star-on.png') %>"
                  data-star-off="<%= asset_path('star-off.png') %>"
                  data-star-half="<%= asset_path('star-half.png') %>">
                </div>

                <span class="text-secondary">
                  <%= material.average_rating %>
                </span>

                </div>

            </div>

          <% end %>


          <div class="text-end mt-3">

            <%= link_to "もっと見る",
                        materials_path( q: { sorts: 'average_rating desc' } ),
                        class: "small text-decoration-none" %>

          </div>

        </div>

      </div>

    </div>

  </div>
</section>