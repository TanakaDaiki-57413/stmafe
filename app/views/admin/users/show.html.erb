<div class="w-50 mt-3" style="margin-left:8em"><%= render "layouts/flash" %></div>
<div class="container">
  <div class="row g-3">
    <div class="col-md-6 col-xl-3">
      <div class="card">
        <%= image_tag @user.get_profile_image(100,100) %>
        
        <%# メールアドレス %>
        <div class="card-title px-1">
          <h3><%= @user.nickname %></h3>
          <p>メールアドレス：<%= @user.email_address %></p>
        </div>

        <%# レビュー数/フォロー数/フォロワー数 %>
        <div class="card-subtitle small mb-2 px-1 text-primary fw-bold">
          レビュー数<%= @user.reviews.count%> |
          フォロー数<%= @user.followings.count %> |
          フォロワー数<%= @user.followers.count %>
        </div>

        <%# 自己紹介文 %>
        <div class="card-body">
          <%= @user.introduction %>
        </div>

        <%# ステータス・編集ボタン %>
        <div class="card-footer d-flex justify-content-between align-items-center">
          ステータス：<%= @user.active_status_i18n %>
          
          <%# ステータスが利用中/利用停止だった時表示する %>
          <% if !(@user.active_status_i18n == "退会") %>
            <%= link_to "編集", edit_admin_user_path(@user), class:"btn btn-success text-end" %>
          <% end %>

        </div>
      </div>
    </div>

    <div class="col-md-6 col-xl-9">
      <h3><%= @user.nickname %>さんのレビュー一覧</h3>
      <% @user.reviews.each do |reviewer| %>
        <div class="row py-3 border-top">

          <%# レビューした教材 %>
          <div class="col-3 d-flex justify-content-center align-items-center">
            <%= image_tag reviewer.material.get_cover_image(200,200),class:"img-fluid"%>
          </div>

          <%# レビュー内容 %>
          <div class="col-9 d-flex flex-wrap">
            <div class="w-100 fs-5 fw-bold">
              <%= reviewer.material.title %>
            </div>

            <div class="w-50">
              <span class="text-warning">★★★★★</span>
            </div>

            <div class="w-50 text-end text-secondary">
              <span>学習時間：<%= reviewer.study_time %>時間</span> 
              <span class="ms-4"><%= reviewer.created_at.strftime("%Y年%m月%d日")%></span>
            </div>

            <div class="w-100 px-2 mt-3 mb-5 text-break">
              <span><%= reviewer.content %></span>
            </div>


            <div class="w-100 text-end">
              <%= link_to "削除", admin_review_path(reviewer,) ,
                          class:"btn btn-danger",
                          data: { 
                            turbo_method: :delete,
                            turbo_confirm: "本当に削除しますか？"
                          }%>
            </div>
          </div>
          
        </div>      
      <% end %>
    </div>      
  </div>
</div>