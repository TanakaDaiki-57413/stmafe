<div class="container w-75 mx-auto">
  <div class="col-12">
    <h1>ユーザ管理</h1>
    <%= search_form_for @q, url: admin_users_path, class:"d-flex align-items-center" do |f| %>
        
      <div class="me-1">
        <%= f.label :nickname_or_email_address_cont, "ユーザー検索",class:"form-label small fw-bold ms-2" %>
        <%= f.text_field :nickname_or_email_address_cont, placeholder:"ニックネーム or email" %>
      </div>
      <div class="me-4">
        <%= f.label :active_status,
                          "ステータス",
                          class: "form-label small fw-bold ms-2" %>

        <%= f.select :active_status_eq, 
            [["利用中", 0], 
            ["退会", 1],
            ["利用停止", 2]], 
            include_blank: "---" %>
      </div>
      <div class="me-3">
        <%= f.label :sorts, "並び替え", class: "form-label small fw-bold" %>
        <%= f.select :sorts, {
           "---": "",
           "【昇順】作成日": "created_at asc",
            "【降順】作成日": "created_at desc",
            "【昇順】レビュー数": "reviews_count asc",
            "【降順】レビュー数": "reviews_count desc"
        }, { selected: params.dig(:q, :sorts) }%>
      </div>
    
      <%= f.submit "検索",class:"btn ms-2 mb-1 border border-dark" %>
      <%= link_to "リセット", admin_users_path, class:"btn ms-1 mb-1 border border-dark"%>
    <% end %>
    <table class="table table-hover mt-3">
      <thead>
        <tr>
          <th>プロフィール画像</th>
          <th>ニックネーム</th>
          <th>メールアドレス</th>
          <th>レビュー数</th>
          <th>作成日</th>
          <th>ステータス</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>
              <%= link_to admin_user_path(user) do %>
                <%= image_tag user.get_profile_image(50,50) %>
              <% end %>
            </td>
            <td><%= link_to user.nickname, admin_user_path(user) %></td>
            <td><%= user.email_address %></td>
            <td><%= user.reviews.count %></td>
            <td><%= user.created_at.strftime("%Y/%m/%d") %></td>
            <td><%= user.active_status_i18n%></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>