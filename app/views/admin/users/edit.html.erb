<div class="container w-50 mx-auto">
  <div class="row mt-4 mb-4 border-bottom">
    <%# プロフィール設定・退会リンクdiv %>
    <div class="row align-items-center">

      <div class="col">
        <h5 class="px-3 py-2 fs-3"><%=@user.nickname%>さんの編集画面</h5>
      </div>
    </div>
  </div>

  <%= render "layouts/flash" %>
  <%= render "layouts/error" ,obj: @user %>

  <%= form_with model: @user,
                url: admin_user_path,
                method: :patch do |form| %>

    <%# プロフィール画像 %>
    <div class="row">
      <% if @user.persisted? && @user.profile_image.attached? %>
        <div>
          <%= image_tag @user.get_profile_image(150,150),
                        class: "img-fluid border object-fit-contain" %>
        </div>
      <% end %>

      <span class="text-decoration-underline">プロフィール画像</span>
    </div>

    <%# ニックネーム入力フォーム %>
    <div class="row mb-4 mt-3 align-items-center">
      <div class="col-8">
        <%= form.label :nickname, "ニックネーム", class: "form-label mb-1" %>

        <%= form.text_field :nickname,
                            required: true,
                            readonly: true,
                            class: "form-control",
                            placeholder: "ニックネーム名" %>

      </div>

    </div>

    <%# 自己紹介入力フォーム %>
    <div class="row mb-4">
      <div class="col-8">
        <%= form.label :introduction, "自己紹介文", class: "form-label mb-1" %>

        <%= form.text_area :introduction,
                            class: "form-control",
                            size: "30x3",
                            readonly: true,
                            placeholder: "自己紹介文" %>

      </div>

    </div>
    
    <%# メールアドレス入力フォーム %>
    <div class="row mb-3 align-items-center">
      <div class="col-md-8">
        <%= form.label :email_address, "メールアドレス", class: "form-label mb-1" %>

        <%= form.text_field :email_address,
                            required: true,
                            readonly: true,
                            class: "form-control",
                            placeholder: "メールアドレス" %>
      </div>
    </div>

    <%# ステータス更新 %>
    <div class="row">
      <div class="col">
        <%= form.radio_button :active_status, User.active_statuses.key(0)%>
        <%= form.label :active_status_status_valid, User.active_statuses_i18n[:status_valid] %><br>
      </div>
      <div class="col">
        <%= form.radio_button :active_status,  User.active_statuses.key(2)%>
        <%= form.label :active_status_status_prohibited, User.active_statuses_i18n[:status_prohibited] %>
      </div>
    </div>

    <%# 更新・キャンセルボタン %>
    <div class="row mt-4 mb-4 d-flex justify-content-evenly">
      <div class="col-3">
        <%= form.submit "更新",
                        class: "btn btn-success px-4" %>
      </div>

      <div class="col-6 mb-4">
        <%= link_to "キャンセル",
                    admin_user_path(@user),
                    class: "btn btn-danger px-4" %>
      </div>
    </div>
  <% end %>
</div>