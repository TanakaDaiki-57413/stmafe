<div class="w-50 mt-3" style="margin-left:8em"><%= render "layouts/flash" %></div>
<div class="container">
  <div class="row g-3">
    <div class="col-md-6 col-xl-3">
      <div class="card">
        <%= image_tag @material.get_cover_image(100,100) %>

        <div class="card-title px-1">
          <h3><%= @material.title %></h3>
        </div>

        <div class="card-subtitle small mb-2 px-1">
          <span>著者：</span>
          <%= @material.author %><br>
          <span>出版社：</span>
          <%= @material.publisher%>
        </div>

        <div class="card-body">
          <span class="small"><%= @material.body %></span>
        </div>

        <div class="card-text px-1 py-2">
          <span>カテゴリ：</span>
          <%= @material.category.name%><br>

          <span>レベル：</span>
          <%= @material.study_level %><br>

          <span>価格(税込)：</span>
          <%= @material.price %>円<br>

          <span>発売日：</span>
          <%= @material.release_date%><br>


          <span>ISBN番号：</span>
          <%= @material.isbn_number%><br>
        </div>

        <div class="card-footer">
          <div class="d-flex align-items-center">
            <span>平均評価：</span>
            <div class="md-star mb-1" 
                  id="show_raty"
                  data-score="<%= @material.average_rating %>"
                  data-star-on="<%= asset_path('star-on.png') %>"
                  data-star-off="<%= asset_path('star-off.png') %>"
                  data-star-half="<%= asset_path('star-half.png') %>">
            </div>
            <div class="ms-2">
              (<%= @material.average_rating %>)
            </div>
          </div>
          <div class="d-flex flex-wrap">
            <% @material.material_tags.each do | tags | %>
              <div class="bg-primary text-light small me-1 rounded-4 px-2 mb-1 mt-1">
                <%= tags.tag.name %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="d-flex  mt-1">
        <%= link_to "編集", edit_admin_material_path(@material), class:"btn btn-success w-100" %>
      </div>

      <div class>
        <%= link_to "削除", 
            admin_material_path(@material), 
            class:"btn btn-danger w-100 mt-2", 
            data: { 
              turbo_method: :delete,
              turbo_confirm: "本当に削除しますか？"
            }%>
      </div>
    </div>
    <%# レビュー一覧 %>
    <div class="col-md-6 col-xl-7">
      <div>
        <h1 class="border-bottom">レビュー一覧</h1>
      </div>
      <div class="w-100 text-end">
        <%= search_form_for @q, url: admin_material_path(@material) do |f| %> 
          <%= f.label :sorts, "並び替え", class: "form-label small fw-bold" %>
          <%= f.select :sorts, {
            "投稿が新しい順": "created_at desc",
            "投稿が古い順": "created_at asc",
            "評価の高い順": "rate desc",
            "勉強時間が多い順": "study_time desc"
          }, { selected: params.dig(:q, :sorts) },{ onchange: 'this.form.submit()' }%>
        <% end %>
      </div>
      <% @reviews.each do |reviewer| %>
        <div class="mt-2">
          <%= image_tag reviewer.user.get_profile_image(100,100) %>
          <br>
          <%= link_to reviewer.user.nickname, admin_user_path(reviewer.user) %>
        </div>

        <div class="d-flex align-items-center w-100">
          <div class="d-flex w-50">
              
            <div id="all_show_raty" 
                  class="xs-star ms-2 raty"
                  data-score="<%= reviewer.rate %>"
                  data-star-on="<%= asset_path('star-on.png') %>"
                  data-star-off="<%= asset_path('star-off.png') %>"
                  data-star-half="<%= asset_path('star-half.png') %>">               
            </div>
            <div class="ms-2">
              (<%= reviewer.rate %>)
            </div>
          </div>

          <div class="w-50 d-flex justify-content-end text-secondary ">
            <span>学習時間：<%= reviewer.study_time %>時間</span> 
            <span class="ms-4"><%= reviewer.created_at.strftime("%Y年%m月%d日")%></span>
          </div>
        </div>

        <div class="px-1 mt-2 text-break">
          <span><%= reviewer.content %></span>
        </div>


        <div class="text-end mt-2 border-bottom py-2">
          <%= link_to "削除", admin_review_path(reviewer) ,
                            class:"btn btn-danger",
                            data: { 
                              turbo_method: :delete,
                              turbo_confirm: "本当に削除しますか？"
                            }%>
        </div>
      <% end %>
    </div>      
  </div>
</div>