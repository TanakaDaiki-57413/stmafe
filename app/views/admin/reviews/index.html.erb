
<div class="container w-75">
  <div class="col-12">
    <%= render "layouts/flash" %>
    <div class="d-flex align-items-end">
      <div class="w-75">
        <h1>レビュー管理</h1>
      </div>

      <%= search_form_for @q, url: admin_reviews_path, class:"w-50 text-end" do |f| %>

        <div>
          <%= f.label :sorts, "並び替え", class: "form-label small fw-bold" %>
          <%= f.select :sorts, {
             "---": "",
              "【昇順】評価": "rate asc",
              "【降順】評価": "rate desc",
              "【昇順】作成日": "created_at asc",
              "【降順】作成日": "created_at desc",
              "【昇順】学習時間": "study_time asc",
              "【降順】学習時間": "study_time desc",
          }, { selected: params.dig(:q, :sorts) },{ onchange: 'this.form.submit()' }%>
        </div>
      <% end %>
    </div>
    <table class="table table-hover mt-2">
      <thead>
        <tr class="text-nowrap">
          <th>レビュー教材</th>
          <th>タイトル</th>
          <th>レビュー内容</th>
          <th>レビュー者</th>
          <th>学習時間</th>
          <th>評価</th>
          <th>作成日</th>
        </tr>
      </thead>
      <tbody>
        <% @reviews.each do |review| %>
          <tr>
            <td>
              <%= link_to admin_review_path(review) do %>
                <%= image_tag review.material.get_cover_image(50,50) %>
              <% end %>
            </td>
            <td><%= link_to review.material.title,
                                  admin_review_path(review) %></td>
            <td class="text-break"><%= truncate(review.content,length:64) %> </td>
            <td>
              <%= link_to admin_user_path(review.user) do%>
                <%= review.user.nickname %>
              <% end%>
            </td>
            <td><%= review.study_time %>時間</td>
            <td><%= review.rate %></td>
            <td><%= review.created_at.strftime("%Y/%m/%d") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>