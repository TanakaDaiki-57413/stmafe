<div class="container">
  <div class="row g-3">
    <div class="col-md-6 col-xl-3">
      <div class="card">
        <%= link_to admin_material_path(@review.material) do %>
          <%= image_tag @review.material.get_cover_image(250,250),class:"img-fluid" %>
        <% end %>
        <div class="card-title px-1">
          <h3><%= @review.material.title %></h3>
        </div>

        <div class="card-subtitle small mb-2 px-1">
          <span>著者：</span>
          <%= @review.material.author %><br>
          <span>出版社：</span>
          <%= @review.material.publisher%>
        </div>

        <div class="card-body">
          <span class="small"><%= @review.material.body %></span>
        </div>

        <div class="card-text px-1 py-2">
          <span>カテゴリ：</span>
          <%= @review.material.category.name%><br>

          <span>レベル：</span>
          <%= @review.material.study_level %><br>

          <span>価格(税込)：</span>
          <%= @review.material.price %>円<br>

          <span>発売日：</span>
          <%= @review.material.release_date%><br>


          <span>ISBN番号：</span>
          <%= @review.material.isbn_number%><br>
        </div>

        <div class="card-footer">
          <div class="d-flex align-items-center">
            <span>平均評価：</span>
            <div class="md-star mb-1" 
                  id="show_raty"
                  data-score="<%= @review.material.average_rating %>"
                  data-star-on="<%= asset_path('star-on.png') %>"
                  data-star-off="<%= asset_path('star-off.png') %>"
                  data-star-half="<%= asset_path('star-half.png') %>">
            </div>
            <div class="ms-2">
              (<%= @review.material.average_rating %>)
            </div>
          </div>
          <div class="d-flex flex-wrap">
            <% @review.material.material_tags.each do | tags | %>
              <div class="bg-primary text-light small me-1 rounded-4 px-2 mb-1 mt-1">
                <%= tags.tag.name %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# レビュー内容 %>
    <div class="col-md-6 col-xl-7">
      <h1 class="border-bottom">レビュー詳細</h1>
      <div>
        <%= image_tag @review.user.get_profile_image(100,100) %>
        <br>
        <%= link_to @review.user.nickname, admin_user_path(@review.user) %>
      </div>

      <div class="d-flex align-items-center w-100">
        <div class="d-flex w-50">
              
          <div id="all_show_raty" 
                class="xs-star  ms-2 raty"
                data-score="<%= @review.rate %>"
                data-star-on="<%= asset_path('star-on.png') %>"
                data-star-off="<%= asset_path('star-off.png') %>"
                data-star-half="<%= asset_path('star-half.png') %>">              
          </div>
          <div class="ms-2">
            (<%= @review.rate %>)
          </div> 
        </div>

        <div class="w-50 d-flex justify-content-end text-secondary ">
          <span>学習時間：<%= @review.study_time %>時間</span> 
          <span class="ms-4"><%= @review.created_at.strftime("%Y年%m月%d日")%></span>
        </div>
      </div>

      <div class="px-1 mt-2 text-break">
        <span><%= @review.content %></span>
      </div>

        
      <div class="text-end mt-4">
        <%= link_to "削除", admin_review_path(@review,review_show_value: true) ,
                          class:"btn btn-danger",
                          data: { 
                            turbo_method: :delete,
                            turbo_confirm: "本当に削除しますか？"
                          }%>
      </div>
    </div>      
  </div>
</div>