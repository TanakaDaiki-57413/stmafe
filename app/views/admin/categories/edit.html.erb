<div class="container">
  <div class="w-50 mt-3"><%= render "layouts/error",obj: @category %></div>
  <div class="row">
    <h1>カテゴリ編集</h1>
  </div>
  <div class="row">
    <div class="col">
      <%= form_with model:@category, 
                    url:admin_category_path,
                    method: :patch,
                    class: :"d-flex" do |form| %>

        <%= form.label :name ,"カテゴリ名" %>
        <%= form.text_field :name%>
        <%= form.submit "更新",class:"me-2" %>
        <%= link_to "キャンセル" ,admin_categories_path %>
      <% end %>
    </div>
  </div>
</div>